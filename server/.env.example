# Copier en server/.env (jamais commité). Toutes les valeurs sont facultatives.
# PORT=4100
# HOST=127.0.0.1
# DB_PATH=data/pos.db
# Origines autorisées (caisse et back-office), séparées par des virgules. Vide = toutes (développement seulement).
# CORS_ORIGINS=http://localhost:5173,http://localhost:5180
# Durée de vie d'une connexion, en heures (7 jours par défaut : la caisse travaille hors ligne).
# TOKEN_TTL_HOURS=168
# Premier administrateur, créé seulement si la base est vide (8 caractères au moins).
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# Connexion à BreakLine (site de précommande), facultative : sans BREAKLINE_URL, le POS fonctionne seul.
# BREAKLINE_URL=https://xxxx.ngrok-free.dev
# BREAKLINE_EMAIL=
# BREAKLINE_PASSWORD=
# Magasin du POS dont le stock suit celui de BreakLine.
# BREAKLINE_STORE_ID=st_2
# TVA appliquée aux articles venus de BreakLine (0, 7, 10, 14 ou 20).
# BREAKLINE_TVA_RATE=0
# Fréquence de la synchronisation, en secondes (10 au moins).
# BREAKLINE_SYNC_SECONDS=60
