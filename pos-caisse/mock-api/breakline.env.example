# Configuration de la passerelle BreakLine (npm run passerelle).
# Copier ce fichier en mock-api/breakline.env (ignoré par git) et le remplir. Ne jamais committer breakline.env.

# Adresse de BreakLine, avec ou sans /api. L'adresse ngrok gratuite change à chaque redémarrage du tunnel.
BREAKLINE_URL=https://unarmored-announcer-automatic.ngrok-free.dev

# Compte BreakLine réservé à la passerelle, avec le rôle vendeur (seller) : il lit le catalogue et ajuste le stock.
BREAKLINE_EMAIL=
BREAKLINE_PASSWORD=

# TVA appliquée aux articles BreakLine, qui n'en ont pas : 0, 7, 10, 14 ou 20. 0 tant que le magasin ne la gère pas.
BREAKLINE_TVA_RATE=0

# Lecture du catalogue BreakLine et nouvel essai d'envoi du stock, toutes les N secondes (10 au moins).
BREAKLINE_SYNC_SECONDS=60
