{
  "name": "pos-caisse",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo",
    "dev:demo": "vite --mode demo",
    "dev:serveur": "vite --mode serveur",
    "lint": "oxlint",
    "preview": "vite preview",
    "mock": "node mock-api/server.js",
    "passerelle": "node --env-file=mock-api/breakline.env mock-api/server.js",
    "dev:all": "concurrently -n api,pos \"npm run mock\" \"npm run dev\"",
    "dev:breakline": "concurrently -n passerelle,pos \"npm run passerelle\" \"npm run dev\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "cors": "^2.8.6",
    "dexie": "^4.4.6",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
